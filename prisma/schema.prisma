// Prisma Schema for Pinorpinor — Dating & Date-Night Platform
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum UserRole {
  MAN
  WOMAN
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum Gender {
  MAN
  WOMAN
}

enum RelationshipIntent {
  CASUAL
  SERIOUS
  FRIENDS
  OPEN
}

enum SwipeAction {
  LIKE
  PASS
  SUPERLIKE
}

enum DateProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
  RESCHEDULED
  CANCELLED
}

enum VerificationStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum MediaType {
  PROFILE_PHOTO
  GALLERY_PHOTO
  VIDEO
  VERIFICATION_SELFIE
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  MATCH
  MESSAGE
  DATE_PROPOSAL
  DATE_ACCEPTED
  DATE_DECLINED
  LIKE_RECEIVED
  PROFILE_VERIFIED
  REPORT_RESOLVED
  SYSTEM
}

// ─────────────────────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────────────────────

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  emailVerified      DateTime?
  passwordHash       String?
  username           String?            @unique
  displayName        String?
  role               UserRole           @default(MAN)
  verificationStatus VerificationStatus @default(NONE)
  isActive           Boolean            @default(true)
  isBanned           Boolean            @default(false)
  banReason          String?
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Dating-specific fields stored on User directly
  birthDate          DateTime?          // Used for server-side 18+ enforcement
  gender             Gender?
  interestedIn       Gender?            // Binary: who they want to see

  // Relations
  datingProfile      DatingProfile?
  media              Media[]
  reviewsGiven       Review[]           @relation("ReviewAuthor")
  reviewsReceived    Review[]           @relation("ReviewSubject")
  sentMessages       Message[]          @relation("Sender")
  conversations      ConversationMember[]
  sessions           Session[]

  // Dating relations
  swipesSent         Swipe[]            @relation("SwipeFrom")
  swipesReceived     Swipe[]            @relation("SwipeTo")
  matchesAsA         Match[]            @relation("MatchUserA")
  matchesAsB         Match[]            @relation("MatchUserB")
  dateProposalsSent  DateProposal[]     @relation("DateProposer")

  // Safety relations
  reportsMade        Report[]           @relation("Reporter")
  reportsReceived    Report[]           @relation("Reported")
  blocksGiven        Block[]            @relation("Blocker")
  blocksReceived     Block[]            @relation("Blocked")

  // Notifications & settings
  notifications      Notification[]
  settings           Settings?

  // Password reset
  passwordResetTokens PasswordResetToken[]

  @@map("users")
  @@index([email])
  @@index([username])
  @@index([role])
  @@index([gender])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// DATING PROFILE (extended profile for all users)
// ─────────────────────────────────────────────────────────────

model DatingProfile {
  id                String              @id @default(cuid())
  userId            String              @unique
  bio               String?             @db.Text
  tagline           String?
  height            String?
  ethnicity         String?
  city              String?
  country           String?
  location          String?             // Human-readable: "Ikeja, Lagos, Nigeria"
  lat               Float?              // Never exposed to other users — server-only
  lng               Float?              // Never exposed to other users — server-only
  relationshipIntent RelationshipIntent?
  dateTypes         String[]            // e.g. ["Dinner Dates", "VIP Events"]
  prompts           Json?               // { "question": "answer" } pairs
  isAvailableToday  Boolean             @default(false)
  isRedHot          Boolean             @default(false)
  isLiveNow         Boolean             @default(false)
  isPublic          Boolean             @default(true)
  isDiscoverable    Boolean             @default(true)  // Can be hidden from swipe deck
  viewCount         Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dating_profiles")
  @@index([city])
  @@index([country])
  @@index([isAvailableToday])
  @@index([isDiscoverable])
}

// ─────────────────────────────────────────────────────────────
// SWIPES (user-to-user like/pass — distinct from post likes)
// ─────────────────────────────────────────────────────────────

model Swipe {
  id          String      @id @default(cuid())
  fromUserId  String
  toUserId    String
  action      SwipeAction
  createdAt   DateTime    @default(now())

  fromUser    User        @relation("SwipeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User        @relation("SwipeTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@map("swipes")
  @@index([fromUserId])
  @@index([toUserId])
  @@index([action])
}

// ─────────────────────────────────────────────────────────────
// MATCHES (created automatically on mutual LIKE)
// ─────────────────────────────────────────────────────────────

model Match {
  id             String    @id @default(cuid())
  userAId        String
  userBId        String
  conversationId String    @unique  // Auto-created conversation
  createdAt      DateTime  @default(now())
  unmatchedAt    DateTime?
  unmatchedBy    String?   // userId of who unmatched

  userA          User         @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB          User         @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  dateProposals  DateProposal[]

  @@unique([userAId, userBId])
  @@map("matches")
  @@index([userAId])
  @@index([userBId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// DATE PROPOSALS (inside a match conversation)
// ─────────────────────────────────────────────────────────────

model DateProposal {
  id               String             @id @default(cuid())
  matchId          String
  proposedByUserId String
  proposedTime     DateTime
  locationName     String
  locationNote     String?            @db.Text
  status           DateProposalStatus @default(PENDING)
  safetyTipsShown  Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  match            Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  proposedBy       User               @relation("DateProposer", fields: [proposedByUserId], references: [id], onDelete: Cascade)

  @@map("date_proposals")
  @@index([matchId])
  @@index([proposedByUserId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// MEDIA (all uploaded files)
// ─────────────────────────────────────────────────────────────

model Media {
  id           String    @id @default(cuid())
  userId       String
  mediaType    MediaType
  storageKey   String    @unique
  storageUrl   String
  thumbnailUrl String?
  mimeType     String?
  fileSize     Int?
  width        Int?
  height       Int?
  duration     Float?
  order        Int       @default(0)
  isApproved   Boolean   @default(true)
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("media")
  @@index([userId])
  @@index([mediaType])
  @@index([userId, mediaType])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────────────────────

model Review {
  id        String       @id @default(cuid())
  authorId  String
  subjectId String
  rating    Int
  comment   String?      @db.Text
  status    ReviewStatus @default(APPROVED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  author    User         @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject   User         @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([authorId, subjectId])
  @@map("reviews")
  @@index([subjectId])
  @@index([authorId])
}

// ─────────────────────────────────────────────────────────────
// MESSAGING
// ─────────────────────────────────────────────────────────────

model Conversation {
  id        String               @id @default(cuid())
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  members   ConversationMember[]
  messages  Message[]
  match     Match?

  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  senderId       String
  content        String?       @db.Text
  mediaUrl       String?
  status         MessageStatus @default(SENT)
  isDeleted      Boolean       @default(false)
  createdAt      DateTime      @default(now())

  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// SAFETY — REPORTS & BLOCKS
// ─────────────────────────────────────────────────────────────

model Report {
  id             String   @id @default(cuid())
  reporterId     String
  reportedUserId String
  reason         String
  details        String?  @db.Text
  isResolved     Boolean  @default(false)
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())

  reporter       User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported       User     @relation("Reported", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@map("reports")
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([isResolved])
}

model Block {
  id          String   @id @default(cuid())
  blockerId   String
  blockedUserId String
  createdAt   DateTime @default(now())

  blocker     User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked     User     @relation("Blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
  @@map("blocks")
  @@index([blockerId])
  @@index([blockedUserId])
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  data      Json?            // e.g. { matchId, conversationId, fromUserId }
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// SETTINGS
// ─────────────────────────────────────────────────────────────

model Settings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  notifyOnMatch          Boolean  @default(true)
  notifyOnMessage        Boolean  @default(true)
  notifyOnDateProposal   Boolean  @default(true)
  notifyOnLike           Boolean  @default(false)
  showInDiscovery        Boolean  @default(true)
  showDistance           Boolean  @default(true)
  maxDistanceKm          Int      @default(50)
  ageRangeMin            Int      @default(18)
  ageRangeMax            Int      @default(60)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

// ─────────────────────────────────────────────────────────────
// PASSWORD RESET TOKENS
// ─────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
  @@index([token])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// AUTH SESSIONS
// ─────────────────────────────────────────────────────────────

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@index([userId])
}
